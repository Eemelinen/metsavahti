{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/global-error.tsx",
    "src/payload/migrations/*.ts",
    "scripts/*.ts",
    "tests/**/*.{ts,tsx}",
    "vitest.*.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"],
  "ignore": ["src/payload-types.ts", "src/components/ui/**", "src/lib/utils.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["pino-pretty", "clsx", "tailwind-merge", "lucide-react"],
  "payload": false,
  "ignoreBinaries": ["osascript"]
}
