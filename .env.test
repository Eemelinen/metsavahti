# ---- Test environment (committed, contains NO real secrets) ------------------
# Loaded by every test command via `dotenv -e .env.test -- ...`.
# Integration tests override DATABASE_URL at runtime with a Testcontainers URL.
# E2E tests use the docker compose service `db_test` on port 5433.
# Every variable the app reads must be defined here so nothing falls back to `.env`.

DATABASE_URL=postgres://metsavahti:metsavahti@localhost:5433/metsavahti_e2e
PAYLOAD_SECRET=test-only-payload-secret-not-for-production
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
PORT=3100
# Separate build dir so e2e can run alongside `pnpm dev` (Next locks per distDir)
NEXT_DIST_DIR=.next-e2e

# WFS is stubbed by tests/e2e/mocks/wfs-server.ts
WFS_BASE_URL=http://localhost:3200/ows/
WFS_LAYER=v1:forestusedeclaration

CRON_SECRET=test-only-cron-secret

EMAIL_FROM=Metsävahti test <noreply@metsavahti.test>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
MAILPIT_API_URL=http://localhost:8025

# Export archives on local disk under the gitignored test-results/ directory; no S3 in tests
EXPORTS_DIR=test-results/exports
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MML_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=warn
# The production default (ticket MV-042: 5/h/IP) so the suites observe the real refusal; every e2e
# test sends its own x-forwarded-for address, so reruns and the three browser projects never share a bucket
AUTH_RATE_LIMIT_PER_HOUR=5
# /virhe throws on purpose so the e2e suite can exercise error.tsx
ENABLE_ERROR_TEST_ROUTE=1
