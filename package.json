{
  "name": "metsavahti",
  "version": "0.1.0",
  "private": true,
  "description": "Metsävahti – watches Metsäkeskus forest use declarations (metsänkäyttöilmoitukset) around your area and notifies you of new or changed declarations nearby.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:up": "docker compose up -d --wait db db_test mailpit",
    "db:down": "docker compose down",
    "db:migrate": "payload migrate",
    "db:migrate:create": "payload migrate:create",
    "db:migrate:status": "payload migrate:status",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "dotenv -e .env.test -- vitest run --project unit",
    "test:integration": "dotenv -e .env.test -- vitest run --project integration",
    "test:watch": "dotenv -e .env.test -- vitest --project unit",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:ci": "dotenv -e .env.test -- pnpm build && CI=1 dotenv -e .env.test -- playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm format:check && pnpm test:unit",
    "check:full": "pnpm check && pnpm test:integration && NEXT_DIST_DIR=.next-check pnpm build",
    "harness:check": "tsx scripts/validate-feature-list.ts",
    "harness:feature": "tsx scripts/harness-feature.ts",
    "harness:verify": "tsx scripts/verify-feature.ts",
    "harness:clean-state": "bash scripts/clean-state-check.sh",
    "harness:loop": "tsx scripts/harness-loop.ts",
    "harness:report": "tsx scripts/harness-loop.ts --report",
    "harness:import-tickets": "tsx scripts/import-tickets.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sentry/nextjs": "10.73.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@turf/turf": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "lucide-react": "1.41.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "p-retry": "8.0.1",
    "payload": "3.88.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "proj4": "2.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-map-gl": "8.1.3",
    "shadcn": "^4.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "wkx": "^0.5.0",
    "zod": "4.5.4",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@hono/node-server": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-playwright": "2.11.0",
    "hono": "4.13.7",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "msw": "2.15.0",
    "pg": "8.20.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "msw"
    ]
  }
}
