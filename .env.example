# ---- Development environment -------------------------------------------------
# Copy to `.env`. Never commit `.env`.
# Tests do NOT read this file; they use the committed `.env.test`.

# PostGIS (docker compose service `db`, port 5432)
DATABASE_URL=postgres://metsavahti:metsavahti@localhost:5432/metsavahti

# Payload: long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Key of the app's signed links (email change, later unsubscribe / export / map image), at least
# 32 characters, e.g. `openssl rand -hex 32`. Empty = derived from PAYLOAD_SECRET.
TOKEN_SECRET=

# Public URL of this app (used in emails and absolute links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Metsäkeskus open data WFS 2.0.0 (CC BY 4.0)
WFS_BASE_URL=https://avoin.metsakeskus.fi/rajapinnat/v1/ows/
WFS_LAYER=v1:forestusedeclaration

# Shared secret for `POST /api/jobs/run` (cron). `openssl rand -hex 32`
CRON_SECRET=change-me-cron-secret

# Email. When SMTP_HOST is set the nodemailer adapter is used (Mailpit locally),
# otherwise Resend is used with RESEND_API_KEY.
EMAIL_FROM=Metsävahti <noreply@metsavahti.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
# Inboxes of the public forms: /yhteystiedot (CONTACT_EMAIL) and /tietopyynto (DPO_EMAIL). Both are
# shown on the pages. Empty = tuki@metsavahti.fi / tietosuoja@metsavahti.fi.
CONTACT_EMAIL=
DPO_EMAIL=

# Account-export archives (`exports` upload collection). Local disk by default; when
# S3_BUCKET is set the S3-compatible adapter is used instead (endpoint optional for AWS).
EXPORTS_DIR=exports
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional integrations
MML_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Analytics script URL (Plausible/Umami, MV-126); loaded only after the visitor accepts analytics
# cookies (MV-090). Empty = no analytics.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=debug

# Auth Server Actions (registration) allowed per IP per hour. Default 5 (ticket MV-042); the
# test suites keep the default and give every e2e test its own x-forwarded-for address.
AUTH_RATE_LIMIT_PER_HOUR=

# Test hooks. `1` enables /virhe, a route that throws on purpose so the e2e suite can
# exercise the error boundary. Leave empty (= off, 404) outside tests.
ENABLE_ERROR_TEST_ROUTE=

# Maintenance: `1` sends every page to /huolto and answers 503 on /api/* (except /api/health).
# MAINTENANCE_RETURN_TIME is shown as "Palaamme noin klo …" (e.g. 07.00); empty = "pian".
MAINTENANCE_MODE=
MAINTENANCE_RETURN_TIME=

# Feature flags. `1` serves the static map image of an alert email (GET /api/alerts/[id]/map-image.png);
# empty = off (404), emails go without the image.
ENABLE_MAP_IMAGES=
# `1` serves /hinnoittelu (plan cards) and links it from the header and sitemap.xml; empty = off (404).
SHOW_PRICING=
